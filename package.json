{
  "name": "black-soil-loop-cloudflare",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build-cloudflare.mjs",
    "test:frontend": "npm run build && node --test \"frontdesign-v1/tests/*.test.mjs\"",
    "cf:check": "npm run build && wrangler deploy --dry-run",
    "cf:dev": "npm run build && wrangler dev",
    "cf:deploy": "npm run build && wrangler deploy",
    "verify:cloud": "node verify-cloudflare.mjs",
    "verify:pages": "node verify-pages-forwarder.mjs",
    "pages:dev": "wrangler pages dev --cwd pages-forwarder",
    "pages:deploy": "wrangler pages deploy --cwd pages-forwarder --project-name black-soil-loop-cn --branch main"
  },
  "devDependencies": {
    "wrangler": "4.116.0"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/noto-sans-sc": "^5.3.0",
    "@fontsource/zcool-qingke-huangyou": "^5.3.0",
    "echarts": "^6.1.0",
    "shapefile": "^0.6.6",
    "sharp": "^0.35.3"
  }
}
