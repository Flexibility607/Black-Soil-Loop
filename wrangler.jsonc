{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "black-soil-loop",
  "compatibility_date": "2026-07-31",
  "main": "cloudflare-worker.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
